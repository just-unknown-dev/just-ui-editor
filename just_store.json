{
  "author": {
    "name": "Just Unknown",
    "url": "https://justunknown.com"
  },
  "category": "editors",
  "description": "Screens are .ui.json assets drawn as real Flutter widgets, with world-space text and buttons, themes, bindings and actions, and the editor that builds them.",
  "editor": {
    "editorOnlyLibraries": [
      "editor.dart",
      "src/editor/"
    ],
    "modules": [
      {
        "class": "UiEditorModule",
        "library": "package:just_ui_editor/editor.dart",
        "order": 40
      }
    ]
  },
  "id": "just_ui_editor",
  "kind": "kit",
  "license": {
    "file": "LICENSE",
    "spdx": "BSD-3-Clause"
  },
  "name": "Interface",
  "previews": [
    "store/card.png"
  ],
  "requires": {
    "just_game_engine": "^2.0.0-dev.2",
    "just_game_engine_editor": "^0.1.0-dev.1"
  },
  "runtime": {
    "extensions": [
      {
        "const": "JustGameUi.extension",
        "library": "package:just_ui_editor/just_ui_editor.dart",
        "order": 20
      }
    ]
  },
  "schema": 1,
  "stage": "experimental",
  "summary": "In-game screens and HUDs, drawn as real Flutter widgets.",
  "tags": [
    "ui",
    "hud",
    "menus",
    "flutter"
  ],
  "version": "0.1.0-alpha.1"
}
